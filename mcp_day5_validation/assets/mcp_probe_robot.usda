#usda 1.0
(
    defaultPrim = "Robot"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Robot"
{
    def Cube "Base" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsCollisionAPI", "PhysicsMassAPI"]
    )
    {
        float physics:mass = 1
        double size = 0.15
        double3 xformOp:translate = (0, 0, 2)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cube "Link" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsCollisionAPI", "PhysicsMassAPI"]
    )
    {
        float physics:mass = 1
        double size = 0.15
        double3 xformOp:translate = (0.3, 0, 2)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def PhysicsFixedJoint "Fixed" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI"]
    )
    {
        rel physics:body1 = </Robot/Base>
        point3f physics:localPos0 = (0, 0, 2)
    }

    def PhysicsRevoluteJoint "Hinge" (
        prepend apiSchemas = ["PhysicsDriveAPI:angular"]
    )
    {
        float drive:angular:physics:damping = 20
        float drive:angular:physics:maxForce = 100
        float drive:angular:physics:stiffness = 100
        float drive:angular:physics:targetPosition = 0
        uniform token physics:axis = "Z"
        rel physics:body0 = </Robot/Base>
        rel physics:body1 = </Robot/Link>
        point3f physics:localPos0 = (0.15, 0, 0)
        point3f physics:localPos1 = (-0.15, 0, 0)
        float physics:lowerLimit = -90
        float physics:upperLimit = 90
    }
}

