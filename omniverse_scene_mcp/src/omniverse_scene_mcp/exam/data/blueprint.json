    {
      "id": 3,
      "name": "Customizing USD",
      "weight": 6,
      "description": "Extending USD with plugins: custom IsA and API schemas, file format plugins, asset resolvers, project-specific model kinds, and fallback variant selections.",
      "objectives": [
        {"id": "3.1", "text": "Compile a plugin so it links against one specific USD release and is discovered through its plugInfo.json.", "keywords": ["plugin", "build", "pluginfo", "cmake", "version", "plugregistry"]},
        {"id": "3.2", "text": "Compile OpenUSD from source with your own choice of dependencies (for example through build_usd.py options).", "keywords": ["build", "source", "dependencies", "build_usd", "cmake"]},
        {"id": "3.3", "text": "Decide when a project-specific model kind is justified and register it through plugInfo.", "keywords": ["kind", "model kind", "custom kind", "pluginfo", "model hierarchy"]},
        {"id": "3.4", "text": "Design IsA or API schemas (generated with usdGenSchema or codeless) to represent in-house data models.", "keywords": ["schema", "usdgenschema", "isa schema", "api schema", "codeless", "custom"]},
        {"id": "3.5", "text": "Plug in a custom Ar resolver so asset paths are resolved on the fly (URIs, versions, databases).", "keywords": ["resolver", "ar", "asset path", "resolution", "uri", "context"]},
        {"id": "3.6", "text": "Carry non-standard attributes and structures through import and export by relying on custom or applied API schemas.", "keywords": ["schema", "custom attributes", "import", "export", "applied api", "namespace"]},
        {"id": "3.7", "text": "Author a Hydra scene index plugin that emits renderable prims procedurally, without matching USD scene data.", "keywords": ["hydra", "scene index", "procedural", "plugin", "renderable"]},
        {"id": "3.8", "text": "Write an asset resolver whose resolved results become renderable prims generated in memory.", "keywords": ["asset resolver", "in-memory", "file format plugin", "procedural", "anonymous layer"]}
      ],
      "readings": [
