    {
      "id": 2,
      "name": "Content Aggregation",
      "weight": 10,
      "description": "Assembling large scenes from modular, reusable models: using native and point instancing to keep memory and load times down, and choosing how to customize instanced assets without giving up those savings.",
      "objectives": [
        {"id": "2.1", "text": "Register an extra prototype on a UsdGeomPointInstancer and point protoIndices at it.", "keywords": ["pointinstancer", "prototype", "protoindices", "prototypes relationship"]},
        {"id": "2.2", "text": "Recolor a mesh reached through an instance proxy while keeping its instanceable state intact.", "keywords": ["instance proxy", "displaycolor", "instanceable", "material", "override"]},
        {"id": "2.3", "text": "Hide selected point-instancer instances cheaply (via invisibleIds) instead of rewriting the instance arrays.", "keywords": ["pointinstancer", "invisibleids", "visibility", "hide", "instances"]},
        {"id": "2.4", "text": "Set up and maintain scenegraph instances so repeated assets share one prototype in very large scenes.", "keywords": ["instancing", "instanceable", "prototype", "reuse", "large scene", "performance"]},
        {"id": "2.5", "text": "Remove or block properties on instanced components in an assembly even though prims under an instance cannot be edited in place.", "keywords": ["instance", "instance proxy", "assembly", "component", "property", "instanceable"]}
      ],
