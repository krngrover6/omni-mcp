      "id": 7,
      "name": "Pipeline Development",
      "weight": 14,
      "description": "Big-picture work for a USD developer or architect: pipeline design, asset management and versioning, diagrams and documentation, tool UX, export hooks that reshape data into the studio's layout, build setups, and shipping flattened assets free of in-house dependencies.",
      "objectives": [
        {"id": "7.1", "text": "Export USD content to other widely used formats like glTF and verify what survives the conversion.", "keywords": ["gltf", "convert", "export", "fidelity", "format"]},
        {"id": "7.2", "text": "Write guidelines for how assets are structured: hierarchy, kinds, layer split, and naming.", "keywords": ["asset structure", "guidelines", "documentation", "kind", "naming"]},
        {"id": "7.3", "text": "Weigh binary crate (.usdc) against text (.usda) for load speed, size, readability, diffing, and archiving.", "keywords": ["usda", "usdc", "crate", "binary", "text", "performance", "archival"]},
        {"id": "7.4", "text": "Build a DCC-to-USD-and-back workflow that keeps data intact on every pass.", "keywords": ["round-trip", "dcc", "import", "export", "fidelity"]},
        {"id": "7.5", "text": "Plug in a custom Ar resolver so asset paths are resolved on the fly (URIs, versions, databases).", "keywords": ["resolver", "ar", "asset path", "resolution", "uri", "context"]},
        {"id": "7.6", "text": "Store custom metadata on layers, prims, or properties (customData, assetInfo, or registered metadata fields).", "keywords": ["metadata", "customdata", "assetinfo", "custom", "sdf"]},
        {"id": "7.7", "text": "Check that asset paths are well formed and resolvable (relative vs absolute, anchoring, search paths).", "keywords": ["asset path", "validate", "anchored", "relative", "resolve"]},
        {"id": "7.8", "text": "Build a new USD importer for a content creation tool, or grow an existing one.", "keywords": ["importer", "dcc", "traverse", "import", "read"]}
