    {
      "id": 6,
      "name": "Debugging and Troubleshooting",
      "weight": 11,
      "description": "Inspecting stages to correct wrong composition results, track down badly authored data, and cut load and render times.",
      "objectives": [
        {"id": "6.1", "text": "Recognize when batching many edits inside an Sdf.ChangeBlock cuts change-processing cost: notifications are queued and sent in one round when the outermost block closes.", "keywords": ["changeblock", "sdf", "performance", "notification", "batch"]},
        {"id": "6.2", "text": "Diagnose why a value authored in some layer is ignored once the stage is composed.", "keywords": ["opinion", "composed stage", "strength", "debugging", "property stack", "override"]},
        {"id": "6.3", "text": "Fix asset-management problems such as unresolved paths, missing layers, resolver contexts, and unloaded payloads.", "keywords": ["asset path", "resolver", "unresolved", "missing layer", "payload"]},
        {"id": "6.4", "text": "Explain typical causes of surprising renders: stale extents, purpose, visibility, flipped orientation, or unit and up-axis mismatches.", "keywords": ["visual", "render", "extent", "purpose", "visibility", "orientation", "metersperunit"]},
        {"id": "6.5", "text": "Use USD's diagnostic and profiling tools: TfDebug flags, diagnostic delegates, Trace, and TfMallocTag.", "keywords": ["tfdebug", "diagnostic", "trace", "profiling", "malloctag", "delegate"]}
      ],
