    {
      "id": 1,
      "name": "Composition",
      "weight": 23,
      "description": "Every composition arc (local opinions, sublayers, inherits, variants, relocates, references, payloads, specializes): what each one does, when to reach for it, and how to reason through layered USDA files to predict which opinion wins.",
      "objectives": [
        {"id": "1.1", "text": "Make a value win or lose by moving its opinion to a stronger or weaker layer, arc, or edit target.", "keywords": ["opinion", "strength", "edit target", "layer", "override", "stronger"]},
        {"id": "1.2", "text": "Pick between scenegraph (native) instancing and point instancing based on copy count and how much each copy must vary.", "keywords": ["instancing", "instanceable", "pointinstancer", "prototype", "scale"]},
        {"id": "1.3", "text": "Tell sublayers, references, and payloads apart and match each one to the situations it suits.", "keywords": ["sublayer", "reference", "payload", "composition arc", "load"]},
        {"id": "1.4", "text": "Reuse one animated asset on several prims, shifting each copy in time with a layer offset on its reference.", "keywords": ["layer offset", "time offset", "reference", "animation", "timesamples", "timecode"]},
        {"id": "1.5", "text": "Plan a layer stack (for example one sublayer per department) so several people can author the same scene without clobbering each other.", "keywords": ["layer stack", "sublayer", "multi-user", "collaboration", "department", "edit target"]},
        {"id": "1.6", "text": "Describe the LIVERPS strength order (local, inherits, variants, relocates, references, payloads, specializes) in plain language.", "keywords": ["liverps", "livrps", "strength ordering", "inherits", "specializes", "relocates"]},
        {"id": "1.7", "text": "Judge when a variant set is the right way to package asset alternatives and when another structure works better.", "keywords": ["variant", "variant set", "variant selection", "asset structure", "lod"]},
        {"id": "1.8", "text": "Diagnose why a value authored in some layer is ignored once the stage is composed.", "keywords": ["opinion", "composed stage", "strength", "debugging", "property stack", "override"]},
        {"id": "1.9", "text": "Package an in-house asset for outside delivery, e.g. by flattening it and removing internal-only paths and dependencies.", "keywords": ["flatten", "export", "delivery", "dependencies", "asset path", "usdz"]},
        {"id": "1.10", "text": "Remove or block properties on instanced components in an assembly even though prims under an instance cannot be edited in place.", "keywords": ["instance", "instance proxy", "assembly", "component", "property", "instanceable"]},
        {"id": "1.11", "text": "Break one monolithic asset into separate layers (geometry, shading, rigging...) so different teams can work on it in parallel.", "keywords": ["monolithic", "split", "layers", "workstream", "asset structure", "collaboration"]}
      ],
