    {
      "id": 4,
      "name": "Data Exchange",
      "weight": 15,
      "description": "Moving data in and out of OpenUSD: writing down how another data model maps onto USD concepts, building importers, exporters and converters, and checking that exported assets are sound.",
      "objectives": [
        {"id": "4.1", "text": "Export USD content to other widely used formats like glTF and verify what survives the conversion.", "keywords": ["gltf", "convert", "export", "fidelity", "format"]},
        {"id": "4.2", "text": "Write down how the concepts of another data model (MaterialX, a DCC scene graph...) map onto USD.", "keywords": ["mapping", "materialx", "data model", "conceptual", "document"]},
        {"id": "4.3", "text": "Weigh binary crate (.usdc) against text (.usda) for load speed, size, readability, diffing, and archiving.", "keywords": ["usda", "usdc", "crate", "binary", "text", "performance", "archival"]},
        {"id": "4.4", "text": "Build a DCC-to-USD-and-back workflow that keeps data intact on every pass.", "keywords": ["round-trip", "dcc", "import", "export", "fidelity"]},
        {"id": "4.5", "text": "Carry non-standard attributes and structures through import and export by relying on custom or applied API schemas.", "keywords": ["schema", "custom attributes", "import", "export", "applied api", "namespace"]},
        {"id": "4.6", "text": "Create usdchecker-style rules confirming that a DCC export produced a well-formed asset.", "keywords": ["validator", "usdchecker", "validation", "integrity", "compliance"]},
        {"id": "4.7", "text": "Implement an exporter or converter that writes USD layers from another source format.", "keywords": ["exporter", "converter", "author", "sdf", "layer"]},
        {"id": "4.8", "text": "Build a new USD importer for a content creation tool, or grow an existing one.", "keywords": ["importer", "dcc", "traverse", "import", "read"]}
